<Window x:Class="Salom.Desktop.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Салома" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#151C24" Foreground="#EDF1F5"
        Icon="assets/salom.ico">
    <StackPanel Margin="25">
        <TextBlock Text="Обновление Салома" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="Installed" Foreground="#9BA8B7" Margin="0,6,0,15"/>
        <TextBlock x:Name="Status" MinHeight="48" TextWrapping="Wrap" FontSize="14"/>
        <ProgressBar x:Name="Progress" Height="5" Foreground="#FFC400" Background="#293544"
                     Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Закрыть" IsCancel="True" Padding="13,8" Margin="0,0,8,0"/>
            <Button x:Name="Action" Content="Проверить" IsDefault="True"
                    Padding="13,8" Background="#FFC400" Foreground="#11161D" Click="Action_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
