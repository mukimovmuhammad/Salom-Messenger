<UserControl x:Class="Salom.Desktop.PhotoPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Preview_Loaded" Unloaded="Preview_Unloaded" DataContextChanged="Preview_DataContextChanged">
    <Grid MaxWidth="380" Margin="0,5,0,0" HorizontalAlignment="Left">
        <Button x:Name="OpenPhoto" Visibility="Collapsed" Click="Open_Click" ToolTip="Открыть фотографию"
                AutomationProperties.Name="Открыть фотографию" Padding="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
            <Image x:Name="Thumbnail" MaxWidth="380" MaxHeight="320" Stretch="Uniform" StretchDirection="DownOnly"
                   AutomationProperties.Name="Предпросмотр фотографии"/>
        </Button>
        <Border x:Name="Placeholder" Width="244" Padding="12" Background="#273442" CornerRadius="9">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Загружаю фото…" Foreground="#D5DEE8" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Loading" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Foreground="#FFC400"/>
                <StackPanel x:Name="Recovery" Visibility="Collapsed" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Повторить" Click="Retry_Click" Padding="8,5"/>
                    <Button Content="Сохранить" Click="Save_Click" Padding="8,5" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
