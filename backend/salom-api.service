[Unit]
Description=SALOM Messenger API
Wants=network-online.target
After=network-online.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=salom-api
Group=salom-api
WorkingDirectory=/opt/salom-api/current/backend
EnvironmentFile=/etc/salom-api/environment
Environment=SALOM_DB=/var/lib/salom-api/directory.sqlite3
Environment=SALOM_MEDIA=/srv/salom-data/media
Environment=SALOM_DB_POOL_SIZE=4
Environment=SALOM_REQUIRE_POSTGRES=1
Environment=SALOM_REQUIRE_REDIS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/salom-api/firebase-admin.json
StateDirectory=salom-api
StateDirectoryMode=0700
ExecStart=/opt/salom-api/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 18731 --workers 1 --limit-concurrency 24 --timeout-keep-alive 5 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=4096:8192
TasksMax=64
MemoryHigh=320M
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/salom-api /srv/salom-data/media

[Install]
WantedBy=multi-user.target
