<Window x:Class="Salom.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Установка Салом" Width="480" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#11161D" Foreground="#EDF1F5" Icon="pack://application:,,,/Salom.Setup;component/assets/salom.ico">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Salom.Setup;component/assets/salom-logo-512.png" Width="54" Height="54" Stretch="Uniform"/><StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Салом для Windows" FontSize="22" FontWeight="Bold"/><TextBlock Text="Версия 0.15.6" Foreground="#9BA8B7" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Установит приложение для текущего пользователя. Администратор Windows не нужен." TextWrapping="Wrap" FontSize="15"/><TextBlock x:Name="LocationText" Foreground="#9BA8B7" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
    <ProgressBar x:Name="InstallProgress" Grid.Row="2" Height="5" IsIndeterminate="True" Visibility="Collapsed" Background="#293544" Foreground="#FFC400"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelButton" Content="Закрыть" Width="100" Margin="0,0,10,0" Padding="12,9" Background="#293544" Foreground="#EDF1F5" Click="Cancel_Click"/><Button x:Name="InstallButton" Content="Установить" Width="130" Padding="12,9" Background="#FFC400" Foreground="#11161D" FontWeight="SemiBold" Click="Install_Click"/></StackPanel>
  </Grid>
</Window>
