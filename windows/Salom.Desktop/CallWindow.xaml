<Window x:Class="Salom.Desktop.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Звонок · Салом" Width="540" Height="620" MinWidth="320" MinHeight="320"
        Background="#11161D" Foreground="#EDF1F5" WindowStartupLocation="CenterOwner" Icon="assets/salom.ico">
    <DockPanel>
        <TextBlock x:Name="CallStatus" DockPanel.Dock="Top" Text="Подключаем звонок…" Foreground="#FFC400"
                   Margin="10,6" TextAlignment="Center" TextWrapping="Wrap"/>
        <wv2:WebView2 x:Name="CallBrowser"/>
    </DockPanel>
</Window>
