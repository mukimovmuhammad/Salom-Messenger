[Unit]
Description=Create an encrypted SALOM PostgreSQL and media backup
After=postgresql.service redis-server.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/salom-api/environment
ExecStart=/usr/local/sbin/salom-backup
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/salom-data/backups
LockPersonality=true
RestrictSUIDSGID=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
