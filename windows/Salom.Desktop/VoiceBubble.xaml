<UserControl x:Class="Salom.Desktop.VoiceBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Bubble_Loaded" Unloaded="Bubble_Unloaded" DataContextChanged="Bubble_Changed">
    <Grid Width="235" Margin="0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
        <Button x:Name="PlayButton" Width="38" Height="38" Padding="0" Click="Play_Click"
                ToolTip="Воспроизвести голосовое" AutomationProperties.Name="Воспроизвести или приостановить голосовое">
            <Path x:Name="PlayIcon" Width="16" Height="16" Stretch="Uniform" Fill="#25241F" Data="M3 1 L15 8 L3 15 Z"/>
        </Button>
        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
            <Grid Height="24">
                <Canvas x:Name="Wave" Height="24" IsHitTestVisible="False" SizeChanged="Wave_SizeChanged"/>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" IsEnabled="False" Opacity="0.01"
                        IsMoveToPointEnabled="True" ValueChanged="Seek_Changed" ToolTip="Перемотать"
                        AutomationProperties.Name="Позиция воспроизведения"/>
            </Grid>
            <TextBlock x:Name="VoiceTime" Text="0:00" FontSize="11" Foreground="#D5DEE8"/>
        </StackPanel>
        <Button Grid.Column="2" Width="30" Height="32" Padding="7" Background="#334353"
                Click="Save_Click" ToolTip="Скачать голосовое" AutomationProperties.Name="Скачать голосовое">
            <Path Stroke="#EDF1F5" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Stretch="Uniform" Data="M8 1 V11 M4 7 L8 11 L12 7 M2 12 V15 H14 V12"/>
        </Button>
    </Grid>
</UserControl>
